        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Set Variables">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">// need to use CompoundVariable with string replacement to avoid generating incorrect groovy when expression resulting string contains groovy special characters (like apostrophes, new lines, etc).
import org.apache.jmeter.engine.util.CompoundVariable

vars.put(&apos;NOTE_CHANCE&apos;, new CompoundVariable(&apos;$#{__P(NOTE_CHANCE,65)}&apos;.replaceAll(&apos;([$#])#\\{&apos;, &apos;$1{&apos;)).execute())
vars.put(&apos;TASK_CHANCE&apos;, new CompoundVariable(&apos;$#{__P(TASK_CHANCE,75)}&apos;.replaceAll(&apos;([$#])#\\{&apos;, &apos;$1{&apos;)).execute())
vars.put(&apos;EVENT_CHANCE&apos;, new CompoundVariable(&apos;$#{__P(EVENT_CHANCE,20)}&apos;.replaceAll(&apos;([$#])#\\{&apos;, &apos;$1{&apos;)).execute())
vars.put(&apos;CASE_CHANCE&apos;, new CompoundVariable(&apos;$#{__P(CASE_CHANCE,20)}&apos;.replaceAll(&apos;([$#])#\\{&apos;, &apos;$1{&apos;)).execute())
vars.put(&apos;LEAD_CONVERSION_RATE&apos;, new CompoundVariable(&apos;$#{__P(CONVERSION_RATE,35)}&apos;.replaceAll(&apos;([$#])#\\{&apos;, &apos;$1{&apos;)).execute())
vars.put(&apos;CLOSING_RATE&apos;, new CompoundVariable(&apos;$#{__P(CLOSING_RATE,50)}&apos;.replaceAll(&apos;([$#])#\\{&apos;, &apos;$1{&apos;)).execute())
SampleResult.ignore = true
</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
