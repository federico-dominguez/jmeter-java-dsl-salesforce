            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">&lt;soapenv:Envelope xmlns:soapenv=&quot;http://schemas.xmlsoap.org/soap/envelope/&quot; xmlns:urn=&quot;urn:enterprise.soap.sforce.com&quot;&gt;&#xd;
   &lt;soapenv:Header&gt;&#xd;
      &lt;urn:SessionHeader&gt;&#xd;
         &lt;urn:sessionId&gt;${__P(ACCESS_TOKEN,)}&lt;/urn:sessionId&gt;&#xd;
      &lt;/urn:SessionHeader&gt;&#xd;
   &lt;/soapenv:Header&gt;&#xd;
   &lt;soapenv:Body&gt;&#xd;
      &lt;urn:convertLead&gt;&#xd;
         &lt;urn:leadConverts&gt;&#xd;
            &lt;urn:convertedStatus&gt;Closed - Converted&lt;/urn:convertedStatus&gt;&#xd;
            &lt;urn:leadId&gt;${leadId}&lt;/urn:leadId&gt;&#xd;
            &lt;urn:doNotCreateOpportunity&gt;false&lt;/urn:doNotCreateOpportunity&gt;&#xd;
            &lt;urn:opportunityName&gt;Deal for ${leadId}&lt;/urn:opportunityName&gt;&#xd;
         &lt;/urn:leadConverts&gt;&#xd;
      &lt;/urn:convertLead&gt;&#xd;
   &lt;/soapenv:Body&gt;&#xd;
&lt;/soapenv:Envelope&gt;</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
